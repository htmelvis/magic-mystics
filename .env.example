# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your-supabase-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# PostHog Analytics
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-project-api-key
# Defaults to https://us.i.posthog.com — change to https://eu.i.posthog.com for EU cloud
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# AI Provider Configuration
# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Other AI Providers
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key
# COHERE_API_KEY=your-cohere-api-key

# Edge Function Secrets (server-side only — NOT exposed to the app)
# Shared secret that authorizes calls to the cost-bearing daily cron functions
# (daily-metaphysical, …). The pg_cron job and manual backfills must send this as
# the `x-cron-secret` request header. Generate a long random value, e.g.:
#   openssl rand -hex 32
DAILY_CRON_SECRET=your-daily-cron-secret
